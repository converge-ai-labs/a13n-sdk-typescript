{
  "name": "@converge.ai/a13n",
  "version": "0.0.0",
  "description": "TypeScript SDK for a13n Service",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "openapi.json"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "packageManager": "npm@11.9.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/converge-ai-labs/a13n-sdk-typescript.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "check:all": "npm run check && npm test && npm run pack:check && npm run package:acceptance",
    "clean": "rm -rf dist *.tgz",
    "generate": "node generate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "pack:check": "npm pack --dry-run",
    "package:acceptance": "node scripts/package-acceptance.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
